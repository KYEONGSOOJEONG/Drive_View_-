<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:padding="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/screen_frame"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="48dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mapChoice"
            style="@style/Widget.DriveView.Choice"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_marginEnd="36dp"
            android:layout_weight="1"
            android:text="@string/pick_on_map" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/categoryChoice"
            style="@style/Widget.DriveView.Choice"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_weight="1"
            android:text="@string/pick_by_category" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/previousButton"
        style="@style/Widget.DriveView.Previous"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:text="@string/previous" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/leaveScenery"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:text="@string/leave_scenery"
        android:textColor="@color/ink"
        android:textSize="18sp" />
</FrameLayout>
