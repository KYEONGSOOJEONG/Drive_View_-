<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:padding="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/screen_frame"
        android:orientation="vertical"
        android:padding="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/scenePage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="28sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sceneTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/sceneNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/area_label"
                    android:textSize="16sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/closeConte"
                style="@style/Widget.DriveView.Previous"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/conte_close" />
        </LinearLayout>

        <ViewFlipper
            android:id="@+id/scenes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1">

            <include
                layout="@layout/conte_scene_entry"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                layout="@layout/conte_scene_qr"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                layout="@layout/conte_scene_target"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                layout="@layout/conte_scene_form"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                layout="@layout/conte_scene_member"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </ViewFlipper>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/prevScene"
                style="@style/Widget.DriveView.Choice"
                android:layout_width="180dp"
                android:layout_height="64dp"
                android:layout_marginEnd="16dp"
                android:text="@string/conte_prev"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nextScene"
                style="@style/Widget.DriveView.Choice"
                android:layout_width="180dp"
                android:layout_height="64dp"
                android:text="@string/conte_next"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
